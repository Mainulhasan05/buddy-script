PORT=5000
NODE_ENV=development

# MongoDB Atlas — REQUIRED
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/social-media?retryWrites=true&w=majority

# Redis — OPTIONAL in dev (leave empty to skip, app uses noop cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ — OPTIONAL in dev (leave empty to skip, counters update synchronously)
RABBITMQ_URL=amqp://localhost:5672

# JWT — REQUIRED (use 32+ random bytes for secrets)
JWT_ACCESS_SECRET=change_me_to_32_or_more_random_bytes_access
JWT_REFRESH_SECRET=change_me_to_32_or_more_random_bytes_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — OPTIONAL in dev (leave empty to disable image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth - OPTIONAL until configured
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# CORS
CLIENT_URL=http://localhost:3000
